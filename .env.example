# ByteAgroX Master Environment Configuration Template
# Copy to .env or app-specific .env files for local development

# ==========================================
# Application General Config
# ==========================================
NODE_ENV=development
PORT=3001
WEB_PORT=3000
API_BASE_URL=http://localhost:3001

# ==========================================
# Database Configuration (PostgreSQL + Drizzle)
# ==========================================
DATABASE_URL=postgresql://byteagrox_user:byteagrox_password@localhost:5432/byteagrox_db
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# ==========================================
# Redis Cache & Queue Config
# ==========================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ==========================================
# Stellar Blockchain Config (Testnet)
# ==========================================
STELLAR_NETWORK=TESTNET
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
STELLAR_FRIENDBOT_URL=https://friendbot.stellar.org
# Escrow Master/Distribution Public Key (Safe to expose public keys)
STELLAR_ESCROW_PUBLIC_KEY=GA...
# Escrow Secret Key (NEVER COMMIT OR EXPOSE SECRET KEYS)
STELLAR_ESCROW_SECRET_KEY=S...

# ==========================================
# Security & Auth Tokens
# ==========================================
JWT_SECRET=super-secret-byteagrox-jwt-token-key-change-in-production
JWT_EXPIRES_IN=7d
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100
